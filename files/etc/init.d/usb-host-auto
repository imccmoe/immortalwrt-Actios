#!/bin/sh /etc/rc.common
START=98
STOP=20
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /bin/true
	procd_close_instance
	detect &
}

stop_service() {
	:
}

detect() {
	local udc state i=0
	sleep 2
	logger -t usb-role "force gadget"
	uci set gc.config.mode=gadget
	uci commit gc
	/etc/init.d/gc restart >/dev/null 2>&1
	sleep 3
	while [ $i -lt 6 ]; do
		udc=$(ls /sys/class/udc/ 2>/dev/null | head -n1)
		[ -n "$udc" ] || break
		state=$(cat "/sys/class/udc/$udc/state" 2>/dev/null)
		case "$state" in
			configured|addressed)
				logger -t usb-role "pc found state=$state, keep gadget"
				return 0
				;;
		esac
		i=$((i+1))
		sleep 2
	done
	logger -t usb-role "no pc state=${state:-none}, switch host"
	uci set gc.config.mode=host
	uci commit gc
	/etc/init.d/gc restart >/dev/null 2>&1
}